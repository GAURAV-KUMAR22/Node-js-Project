<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/forms.css">
<link rel="stylesheet" href="/css/auth.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
    <%- include('../includes/navigation.ejs') %>

    <main>
        <% if (errorMessage) { %>
            <div class="user-message user-message--error">
                <%= errorMessage %>
            </div>
        <% } %>

        <main class="form-signin customLogin">
            <form action="/signup" method="POST" novalidate>
                <h1 class="h3 mb-3 fw-normal">Please Sign Up</h1>

                <div class="form-floating">
                    <input type="text" name="username"
                        class="form-control <%= validationErrors.find(e => e.param === 'username') ? 'invalid' : '' %>"
                        id="username" placeholder="Username" value="<%= oldInput.username %>">
                    <label for="username">UserName</label>
                </div>

                <div class="form-floating">
                    <input type="email" name="email"
                        class="form-control <%= validationErrors.find(e => e.param === 'email') ? 'invalid' : '' %>"
                        id="email" placeholder="Email" value="<%= oldInput.email %>">
                    <label for="email">E-Mail</label>
                </div>

                <div class="form-floating">
                    <input type="password" name="password"
                        class="form-control <%= validationErrors.find(e => e.param === 'password') ? 'invalid' : '' %>"
                        id="password" placeholder="Password" value="<%= oldInput.password %>">
                    <label for="password">Password</label>
                </div>

                <div class="form-floating">
                    <input type="password" name="confirmPassword"
                        class="form-control <%= validationErrors.find(e => e.param === 'confirmPassword') ? 'invalid' : '' %>"
                        id="confirmPassword" placeholder="Confirm Password" value="<%= oldInput.confirmPassword %>">
                    <label for="confirmPassword">Confirm Password</label>
                </div>

                <!-- Role Selection Dropdown -->
                <div class="form-floating">
                    <select name="role" id="role" class="form-control">
                        <option value="user" <%= oldInput.role === 'user' ? 'selected' : '' %>>User</option>
                        <option value="admin" <%= oldInput.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                    <label for="role">Select Role</label>
                </div>

                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <button class="w-100 btn btn-lg btn-primary bg-green-500" type="submit">Signup</button>
            </form>
        </main>
    </main>

    <%- include('../includes/end.ejs') %>
